# Backend
PORT=3000
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/restablecer
# For running Node directly on Windows; Docker Compose sets its own internal URL.
REDIS_URL=redis://127.0.0.1:6379
# Set true to require virtual-queue admission before online ticket purchases.
WAITING_ROOM_ENABLED=false
QUEUE_TOKEN_SECRET=
WAITING_ROOM_MAX_ACTIVE=50
WAITING_ROOM_ACCESS_MS=600000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Enable email verification on public registration (true/false)
EMAIL_VERIFICATION_REQUIRED=false
# Optional for password recovery redirects
# FRONTEND_URL can be comma-separated for multiple origins