      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "05 - Crear producto de prueba (stock 12)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Producto creado: HTTP 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.test('El producto tiene stock 12', function () { pm.expect(json.product.stock).to.eql(12); });",
              "if (json.product && json.product.id) { pm.collectionVariables.set('productId', json.product.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Tribuna360 API Test {{$timestamp}}\",\n  \"description\": \"Producto temporal creado por la colección de pruebas\",\n  \"price\": 1,\n  \"stock\": 12,\n  \"tenant_id\": \"{{tenantId}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/productos"
      }
    },
    {
      "name": "06 - Rechazar stock negativo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
