{
  "info": {
    "_postman_id": "d35a3ee8-2dc3-4ad9-bc45-9f4bca7f7c32",
    "name": "Tribuna 360 - Pruebas funcionales API",
    "description": "Pruebas funcionales de autenticación, productos, tenants, partidos, usuarios, membresías, pedidos, pagos, solicitudes de clubes y catálogos. Configura las variables email, password y tenantId antes de ejecutar. La colección crea un producto temporal y lo elimina al final.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Login válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login responde 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('La respuesta contiene token', function () { pm.expect(json.data).to.have.property('token'); });",
              "if (json.data && json.data.token) { pm.collectionVariables.set('token', json.data.token); }"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "02 - Login inválido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Credenciales incorrectas responden 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"usuario-inexistente@example.com\",\n  \"password\": \"ClaveIncorrecta123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "03 - Perfil autenticado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Perfil autenticado responde 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "04 - Perfil sin token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sin token responde 401', function () { pm.response.to.have.status(401); });"
            ]
          }
