        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Producto inválido negativo\",\n  \"price\": 1,\n  \"stock\": -2,\n  \"tenant_id\": \"{{tenantId}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/productos"
      }
    },
