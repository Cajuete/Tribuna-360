        },
        "url": "{{baseUrl}}/api/v1/productos"
      }
    },
    {
      "name": "08 - Actualizar stock a cero",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Actualización responde 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Stock actualizado a cero', function () { pm.expect(json.product.stock).to.eql(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stock\": 0\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/productos/{{productId}}"
      }
    },
    {
      "name": "09 - Consultar producto creado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Consulta por ID responde 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('El producto contiene stock', function () { pm.expect(json.data).to.have.property('stock'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/productos/{{productId}}"
      }
    },
